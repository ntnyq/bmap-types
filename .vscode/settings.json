{
  "oxc.enable": true,
  "eslint.enable": false,
  "prettier.enable": false,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "js/ts.experimental.useTsgo": true,
  "cSpell.words": [
    "bmap",
    "bumpp",
    "changelogithub",
    "codecov",
    "esbuild",
    "lcov",
    "onaddcontrol",
    "onaddoverlay",
    "onaddtilelayer",
    "onclearoverlays",
    "ondragging",
    "ondrawend",
    "onhighlight",
    "onhotspotclick",
    "onhotspotout",
    "onhotspotover",
    "oninfowindowclose",
    "oninfowindowopen",
    "onlinks",
    "onlocation",
    "onlongpress",
    "onmaptypechange",
    "onmaximize",
    "onmoveend",
    "onmovestart",
    "onmoving",
    "onposition",
    "onpov",
    "onremove",
    "onremovecontrol",
    "onremoveoverlay",
    "onremovetilelayer",
    "onrestore",
    "onrightclick",
    "onrightdblclick",
    "onscene",
    "ontilesloaded",
    "onviewchanged",
    "onviewchanging",
    "oxfmt",
    "oxlint",
    "pano",
    "pnpm",
    "Pois",
    "toitem",
    "tsdown",
    "tsgo",
    "unrs",
    "vite",
    "vitepress",
    "vitest"
  ],
  "cSpell.allowCompoundWords": true
}
